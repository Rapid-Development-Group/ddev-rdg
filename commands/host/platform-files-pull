#!/usr/bin/env bash

#ddev-generated
## Description: Pull the public files from a Platform.sh environment (database untouched)
## Usage: platform-files-pull [environment]
## Example: "ddev platform-files-pull" or "ddev platform-files-pull staging"

set -euo pipefail

# The files half of platform-db-pull, same ergonomics. Sugar for:
#   ddev pull platform --skip-db --environment="PLATFORM_ENVIRONMENT=<env>"
# The provider's files_import_command downloads the one mount that matters
# (web/sites/default/files) into $DDEV_FILES_DIR.
source "${DDEV_APPROOT:?must be run through ddev}/.ddev/rdg/pull-args.sh"

rdg_pull_parse_env "$(basename "$0")" "$@"

args=(pull platform --skip-db)

# Announce the target: DDEV's confirmation prompt never names the environment.
# See platform-db-pull for the rest of the reasoning.
if [ -n "$RDG_PULL_ENV" ]; then
  args+=(--environment="PLATFORM_ENVIRONMENT=$RDG_PULL_ENV")
  printf "Pulling the public files from Platform.sh environment '%s'" "$RDG_PULL_ENV"
  printf ' (an inactive environment will be resumed).\n'
else
  printf 'Pulling the public files from the environment pinned in .ddev/config.yaml.\n'
fi

exec ddev "${args[@]}"
