#!/usr/bin/env bash

#ddev-generated
## Description: Derive DDEV config from .platform.app.yaml and .platform/services.yaml
## Usage: rdg-sync
## Example: "ddev rdg-sync"

set -euo pipefail

# A host command, not a web command: /mnt/ddev_config is bind-mounted READ-ONLY
# in the web container, and the alternative -- the read-write project mount at
# /var/www/html/.ddev -- is Mutagen-synced, so a write there can take several
# seconds to become visible on the host. Neither lets 'ddev rdg-sync && git add'
# work reliably. Running on the host instead means every write below lands
# directly on the real filesystem, visible to git immediately. yq/jq still only
# ever run inside the web container, via 'ddev exec' -- this script never
# requires either on the host.
project_root="${DDEV_APPROOT:?must be run through ddev}"
ddev_dir="$project_root/.ddev"
rdg_dir="$ddev_dir/rdg"

generated="$ddev_dir/config.platformsh.yaml"
nginx_conf="$ddev_dir/nginx/platform-locations.conf"
dockerfile="$ddev_dir/web-build/Dockerfile.rdg-theme"

# --- pre-flight: the repo must not declare these two keys itself -------------
# DDEV APPENDS list keys when it merges .ddev/config*.yaml; it does not replace
# them. So a hand-written web_extra_daemons / web_extra_exposed_ports block does
# not get overridden by the one derived below -- the two coexist, and if both
# claim the same container_port DDEV refuses to load the project at all. Every
# later 'ddev' command, 'ddev describe' included, then fails. Writing the file
# and reporting success would leave the project unusable, so refuse up front and
# write nothing. Gathering before writing does not help here: the conflict is in
# the two files' content coexisting on disk, not in write ordering.
#
# These are the only two list keys this command emits; every other key it writes
# is a scalar, and scalars do override cleanly. So the check does not need to be
# general.
#
# grep, not yq: end users must need no tooling on the host, and this has to work
# when the project is stopped, which rules out 'ddev exec'.
#
# Anchored at column 0, with no leading whitespace allowed. Only a top-level key
# is one DDEV merges, so indentation means the match is something else -- a
# nested mapping, a documentation fragment -- that DDEV loads without complaint.
# Refusing on one of those would send a developer looking for a conflicting block
# that does not exist. The same anchor is what keeps a commented-out block from
# counting, since the '#' has to come first.
conflicts=""
for candidate in "$ddev_dir"/config*.yaml; do
  [ -f "$candidate" ] || continue
  [ "$candidate" = "$generated" ] && continue
  for key in web_extra_daemons web_extra_exposed_ports; do
    if grep -Eq "^${key}[[:space:]]*:" "$candidate"; then
      conflicts="${conflicts}  ${key} in .ddev/$(basename "$candidate")
"
    fi
  done
done

if [ -n "$conflicts" ]; then
  {
    echo "rdg-sync: this project still declares these itself:"
    echo
    printf '%s' "$conflicts"
    echo
    echo "Delete those blocks. 'ddev rdg-sync' now derives the theme daemon and its"
    echo "exposed ports from .platform.app.yaml, and DDEV appends list keys when it"
    echo "merges .ddev/config*.yaml instead of replacing them -- so a hand-written block"
    echo "would survive alongside the derived one and DDEV would reject the project for"
    echo "a duplicate container_port. Nothing was written."
  } >&2
  exit 1
fi

# Runs one step inside the web container and prints its stdout; stderr passes
# straight through live, so e.g. derive.sh's own warnings still reach the
# user's terminal. Writing the generated config can make a repo's OWN existing
# config conflict with it (e.g. a container_port collision with a
# not-yet-removed hand-written daemon block), which breaks every subsequent
# 'ddev exec' in this same project until someone deletes the file we just
# wrote. So every container call happens below BEFORE any file is written:
# either the whole set of container calls succeeds and we write a complete
# set of files, or one fails and we exit having written nothing, leaving the
# project exactly as loadable as it was before this command ran.
run_in_container() {
  local output
  if ! output="$(ddev exec "$@")"; then
    echo "rdg-sync: '$*' failed in the web container; nothing was written." >&2
    exit 1
  fi
  printf '%s' "$output"
}

# --- gather everything from the container first -----------------------------

config="$(run_in_container bash /mnt/ddev_config/rdg/derive.sh /var/www/html)"

# No yq on the host: these lines are plain enough for sed.
app_config_rel="$(printf '%s' "$config" | sed -n 's/^# source-files: \([^ ]*\).*/\1/p')"
docroot="$(printf '%s' "$config" | sed -n 's/^docroot: *//p' | head -1)"
needs_theme_toolchain="no"
printf '%s' "$config" | grep -q '^# needs-theme-toolchain: yes$' && needs_theme_toolchain="yes"

locations=""
if [ -n "$docroot" ]; then
  locations="$(run_in_container bash /mnt/ddev_config/rdg/nginx-locations.sh "/var/www/html/$app_config_rel" "$docroot")"
fi

# Deliberately a check, not a config write. Deriving `php<ver>-<ext>` packages
# adds redundancy -- DDEV's image already ships redis and apcu -- and risks a
# package name that does not exist. Both the declared list and the loaded list
# come from inside the container; only the comparison happens on the host.
declared_extensions="$(
  run_in_container yq -r '
    (.runtime.extensions // [])
    + ( [ .stack.runtimes[]? | select(tag == "!!map") | to_entries[0].value.extensions // [] ] | flatten )
    | .[]
  ' "/var/www/html/$app_config_rel" | sort -u
)"
loaded_extensions="$(run_in_container php -m)"

# --- everything above succeeded: only now write / remove --------------------

printf '%s\n' "$config" > "$generated"
echo "Wrote $(basename "$generated")"

mkdir -p "$(dirname "$nginx_conf")"
if [ -n "$locations" ]; then
  printf '%s\n' "$locations" > "$nginx_conf"
  echo "Wrote nginx/$(basename "$nginx_conf")"
else
  rm -f "$nginx_conf"
fi

# A Dockerfile, not webimage_extra_packages: DDEV replaces rather than
# concatenates list keys when merging config.*.yaml, so writing that key would
# silently discard packages the repo set for its own reasons.
mkdir -p "$(dirname "$dockerfile")"
if [ "$needs_theme_toolchain" = "yes" ]; then
  cat > "$dockerfile" <<'EOF'
# GENERATED by 'ddev rdg-sync'. Do not edit.
# Build toolchain for the theme asset pipeline. imagemin's binaries ship
# x86_64-only prebuilts, so on Apple silicon they compile from source.
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake libtool dh-autoreconf make zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
EOF
  echo "Wrote web-build/$(basename "$dockerfile")"
else
  rm -f "$dockerfile"
fi

missing=""
for extension in $declared_extensions; do
  printf '%s\n' "$loaded_extensions" | grep -qix "$extension" || missing="$missing $extension"
done
if [ -n "$missing" ]; then
  echo "WARNING: declared in $app_config_rel but not loaded in the web container:$missing" >&2
fi

echo
echo "Commit the generated files, then run 'ddev restart' to apply them."
